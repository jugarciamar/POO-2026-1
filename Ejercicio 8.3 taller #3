import tkinter as tk
from tkinter import messagebox
import math


class VentanaFiguras(tk.Toplevel):
    def __init__(self, padre, titulo):
        super().__init__(padre)
        self.title(titulo)
        self.resizable(False, False)
        self.grab_set()

        self.entradas = {}

        self.crear_campos()
        self.crear_botones()
        self.crear_resultados()

    def crear_campos(self):
        raise NotImplementedError

    def calcular(self):
        raise NotImplementedError

    def agregar_campos(self, etiqueta, clave, fila):
        lbl = tk.Label(self, text=etiqueta)
        lbl.grid(row=fila, column=0, padx=15, pady=5, sticky="w")

        entrada = tk.Entry(self, width=15)
        entrada.grid(row=fila, column=1, padx=10, pady=5, sticky="w")

        self.entradas[clave] = entrada

    def crear_botones(self):
        btn_calcular = tk.Button(self, text="Calcular", width=15, command=self.calcular)
        fila = len(self.entradas)
        btn_calcular.grid(row=fila, column=0, columnspan=2, pady=10)

    def crear_resultados(self):
        self.var_volumen = tk.StringVar(value="Volumen (cm3):")
        self.var_superficie = tk.StringVar(value="Superficie (cm2):")

        fila_base = len(self.entradas) + 1

        for idx, var in enumerate([self.var_volumen, self.var_superficie]):
            tk.Label(self, textvariable=var, anchor="w", font=("Arial", 9, "bold")).grid(row=fila_base + idx, column=0, columnspan=2, padx=15, sticky="w")

    def obtener_valor(self, clave, nombre):
        texto = self.entradas[clave].get().strip()

        if texto == "":
            messagebox.showwarning("Campo vacio", f"el campo'{nombre}' es obligatorio")
            self.entradas[clave].focus()
            return None

        try:
            valor = float(texto)
            if valor <= 0:
                raise ValueError
            return valor
        except ValueError:
            messagebox.showwarning("Dato inválido", f"'{nombre}' debe ser un número positivo.")
            self.entradas[clave].focus()
            return None

    def mostrar_resultados(self, volumen, superficie):
        self.var_volumen.set(f"Volumen (cm3): {volumen:.2f}")
        self.var_superficie.set(f"Superficie (cm2): {superficie:.2f}")


class VentanaCilindro(VentanaFiguras):
    def __init__(self, padre):
        super().__init__(padre, "Cilindro")

    def crear_campos(self):
        self.agregar_campos("Radio (cms):", "radio", 0)
        self.agregar_campos("Altura (cms):", "altura", 1)

    def calcular(self):
        radio = self.obtener_valor("radio", "Radio")
        if radio is None: return

        altura = self.obtener_valor("altura", "Altura")
        if altura is None: return

        volumen = math.pi * radio**2 * altura
        superficie = 2 * math.pi * radio * (radio + altura)

        self.mostrar_resultados(volumen, superficie)


class VentanaEsfera(VentanaFiguras):
    def __init__(self, padre):
        super().__init__(padre, "Esfera")

    def crear_campos(self):
        self.agregar_campos("Radio (cms):", "radio", 0)

    def calcular(self):
        radio = self.obtener_valor("radio", "Radio")
        if radio is None:
            return

        volumen = (4/3) * math.pi * radio**3
        superficie = 4 * math.pi * radio**2

        self.mostrar_resultados(volumen, superficie)


class VentanaPiramide(VentanaFiguras):
    def __init__(self, padre):
        super().__init__(padre, "Piramide")

    def crear_campos(self):
        self.agregar_campos("Base (cms):", "base", 0)
        self.agregar_campos("Altura (cms):", "altura", 1)
        self.agregar_campos("Apotema (cms):", "apotema", 2)

    def calcular(self):
        base = self.obtener_valor("base", "Base")
        if base is None:
            return

        altura = self.obtener_valor("altura", "Altura")
        if altura is None:
            return

        apotema = self.obtener_valor("apotema", "Apotema")
        if apotema is None:
            return

        volumen = (1/3) * base**2 * altura
        superficie = base**2 + 2 * base * apotema

        self.mostrar_resultados(volumen, superficie)


class VentanaCubo(VentanaFiguras):
    def __init__(self, padre):
        super().__init__(padre, "Cubo")

    def crear_campos(self):
        self.agregar_campos("Lado (cms):", "lado", 0)

    def calcular(self):
        lado = self.obtener_valor("lado", "Lado")
        if lado is None: return

        volumen = lado**3
        superficie = 6 * lado**2

        self.mostrar_resultados(volumen, superficie)


class VentanaPrisma(VentanaFiguras):
    def __init__(self, padre):
        super().__init__(padre, "Prisma")

    def crear_campos(self):
        self.agregar_campos("Base (cms):", "base", 0)
        self.agregar_campos("Altura (cms):", "altura", 1)
        self.agregar_campos("Perímetro base:", "perimetro", 2)

    def calcular(self):
        base = self.obtener_valor("base", "Base")
        if base is None: return

        altura = self.obtener_valor("altura", "Altura")
        if altura is None: return

        perimetro = self.obtener_valor("perimetro", "Perímetro")
        if perimetro is None: return

        volumen = base * altura
        superficie = 2 * base + perimetro * altura

        self.mostrar_resultados(volumen, superficie)


class VentanaPrincipal(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Figuras")
        self.resizable(False, False)
        self.geometry("380x120")
        self.crear_widgets()

    def crear_widgets(self):
        frame1 = tk.Frame(self)
        frame1.pack(pady=10)

        figuras_principales = [
            ("Cilindro", VentanaCilindro),
            ("Esfera",   VentanaEsfera),
            ("Pirámide", VentanaPiramide),
        ]

        for nombre, clase in figuras_principales:
            tk.Button(frame1, text=nombre, width=10, command=lambda c=clase: c(self)).pack(side="left", padx=5)

        frame2 = tk.Frame(self)
        frame2.pack(pady=5)


        figuras_extra = [
            ("Cubo",   VentanaCubo),
            ("Prisma", VentanaPrisma),
        ]

        for nombre, clase in figuras_extra:
            tk.Button(frame2, text=nombre, width=8, command=lambda c=clase: c(self)).pack(side="left", padx=5)


if __name__ == "__main__":
    app = VentanaPrincipal()
    app.mainloop()
