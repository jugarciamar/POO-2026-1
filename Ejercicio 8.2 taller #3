import tkinter as tk
from tkinter import messagebox
import math

class AplicaionNotas (tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Notas de estudiantes")
        self.resizable(False, False)
        self.geometry("380x340")

        self.entradas = []

        self.crear_widgets()

    def crear_widgets(self):
        for i in range (1,6):
            etiqueta = tk.Label(self, text=f"Nota {i}:")
            etiqueta.grid(row=i-1, column=0, padx=15, pady=5, sticky="w")

            entrada = tk.Entry(self, width=20)
            entrada.grid(row=i-1, column=1, padx=10, pady=5, sticky="w")
            
            self.entradas.append(entrada)

        frame_botones = tk.Frame(self)
        frame_botones.grid(row=5, column=0, columnspan=2, pady=10)

        btn_calcular = tk.Button(frame_botones, text="Calcular Promedio", width = 18, command=self.calcular_promedio)
        btn_calcular.pack(side="left", padx=10)

        btn_limpiar = tk.Button(frame_botones, text="Limpiar", width = 18, command=self.limpiar_entradas)
        btn_limpiar.pack(side="left", padx=10)

        self.var_promedio = tk.StringVar(value = "Promedio:")
        self.var_desviacion = tk.StringVar(value = "Desviacion Estandar:")
        self.var_mayor = tk.StringVar(value = "Nota Mayor:")
        self.var_menor = tk.StringVar(value = "Nota Menor:")

        resultados = [
            self.var_promedio,
            self.var_desviacion,
            self.var_mayor,
            self.var_menor,
        ]

        for idx, variable in enumerate(resultados):
            lbl = tk.Label(self, textvariable=variable,
                           anchor="w", font=("Arial", 9, "bold"))
            lbl.grid(row=6 + idx, column=0, columnspan=2,
                     padx=15, sticky="w")

    def obtener_notas(self):
        notas = []

        for i, entradas in enumerate(self.entradas, start=1):
            texto = entradas.get().strip()

            if texto == "":
                messagebox.showwarning("Advertencia", f"Ingrese la nota {i}")
                entradas.focus()

                return None
            
            try:
                valor = float(texto)
                if 0 <= valor <= 5:
                    notas.append(valor)
                else:
                    messagebox.showwarning("Advertencia", f"La nota {i} debe estar entre 0 y 5")
                    entradas.focus()
                    return None
            except ValueError:
                messagebox.showwarning("Advertencia", f"La nota {i} debe ser un numero valido")
                entradas.focus()
                return None
        
        return notas
    
    def calcular_promedio(self):
        notas = self.obtener_notas()
        if notas is None:
            return

        num_notas = len(notas)
        
        promedio = sum(notas) / num_notas

        varianza = sum((nota - promedio) ** 2 for nota in notas) / num_notas
        desviacion = math.sqrt(varianza)

        mayor = max(notas)
        menor = min(notas)

        self.var_promedio.set(f"Promedio: {promedio:.2f}")
        self.var_desviacion.set(f"Desviacion Estandar: {desviacion:.2f}")
        self.var_mayor.set(f"Nota Mayor: {mayor:.1f}")
        self.var_menor.set(f"Nota Menor: {menor:.1f}")

    def limpiar_entradas(self):
        for entradas in self.entradas:
            entradas.delete(0, tk.END)

        self.entradas[0].focus()

        self.var_promedio.set("Promedio:")
        self.var_desviacion.set("Desviacion Estandar:")
        self.var_mayor.set("Nota Mayor:")
        self.var_menor.set("Nota Menor:")

if __name__ == "__main__":
    app = AplicaionNotas()
    app.mainloop()
